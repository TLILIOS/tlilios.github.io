# Headers sécurité globaux (audit 2026-06-10 §5 — impossibles sur GitHub Pages)
# CSP : script-src/style-src 'unsafe-inline' requis par l'architecture inline du one-page ;
# Calendly en click-to-load (script + css assets.calendly.com, iframe calendly.com).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https://*.calendly.com; frame-src https://calendly.com; connect-src 'self' https://calendly.com; media-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Médias : 7 jours (non fingerprintés — renommer le fichier à chaque remplacement ;
# passer en max-age=31536000, immutable si fingerprinting adopté)
/demo_fichechef.mp4
  Cache-Control: public, max-age=604800
/poster_fichechef.jpg
  Cache-Control: public, max-age=604800
/demo_seniorprep.mp4
  Cache-Control: public, max-age=604800
/demo_eventorias.mp4
  Cache-Control: public, max-age=604800
/demo_medistock.mp4
  Cache-Control: public, max-age=604800
/demo_tajmahal.mp4
  Cache-Control: public, max-age=604800
/poster_seniorprep.jpg
  Cache-Control: public, max-age=604800
/poster_eventorias.jpg
  Cache-Control: public, max-age=604800
/poster_medistock.jpg
  Cache-Control: public, max-age=604800
/poster_tajmahal.jpg
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800

# security.txt (RFC 9116) : texte brut, à renouveler avant la date Expires.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# AASA FicheChef (Universal Links) — la règle est prête, le fichier sera ajouté
# dans public/.well-known/ à la publication de l'app. Apple exige application/json.
/.well-known/apple-app-site-association
  Content-Type: application/json
