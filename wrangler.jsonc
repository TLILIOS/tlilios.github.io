{
  // Cloudflare Workers Static Assets — site vitrine Prim (primapp.dev)
  // Worker assets-only : aucun script, tout est servi depuis ./public.
  // Déploiement : exclusivement via Workers Builds (app Git-connectée
  // primapp-portfolio, build sur push main). Pas de `wrangler deploy` manuel —
  // deux canaux de déploiement ont déjà causé une divergence prod (audit 2026-06-10).
  // Custom domain primapp.dev attaché à l'app dans le dashboard (DNS + certificat
  // gérés par Cloudflare) — pas de bloc routes ici pour éviter tout double pilotage.
  // www est porté par le worker dédié redirect-www/ (301 vers l'apex) :
  // Static Assets n'accepte que des URLs relatives dans _redirects,
  // et un script run_worker_first ici ferait perdre les requêtes statiques gratuites.
  "name": "primapp-portfolio",
  "compatibility_date": "2026-06-10",
  // workers_dev explicite : pas d'URL *.workers.dev en doublon du domaine custom.
  "workers_dev": false,
  // Version/Preview URLs (<version>-<nom>.<sous-domaine>.workers.dev) fermées explicitement :
  // sans ce champ, Wrangler conserve un réglage existant éventuellement ouvert.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    // Sert public/404.html avec un statut 404 sur toute route inconnue
    "not_found_handling": "404-page",
    // /support → /support.html, /support.html → /support (308) : URLs propres
    "html_handling": "auto-trailing-slash"
  }
}
